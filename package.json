{
  "name": "ai-commit-messages",
  "displayName": "AI Commit Messages",
  "description": "Generate git commit messages with a local or self-hosted LLM — Ollama and any OpenAI-compatible endpoint. Conventional Commits + gitmoji, offline, no telemetry.",
  "version": "0.0.0",
  "publisher": "solvelab",
  "private": true,
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#161922",
    "theme": "dark"
  },
  "categories": [
    "SCM Providers",
    "Machine Learning"
  ],
  "keywords": [
    "ai commit",
    "commit message",
    "ai commit message",
    "commit generator",
    "conventional commits",
    "gitmoji",
    "git",
    "scm",
    "source control",
    "ollama",
    "local llm",
    "llm",
    "openai compatible",
    "lm studio",
    "openrouter",
    "groq",
    "llama.cpp",
    "vllm",
    "offline",
    "privacy",
    "self-hosted",
    "byok",
    "qwen",
    "generate commit message"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "author": {
    "name": "didevlab",
    "url": "https://github.com/didevlab"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/solvelab/ai-commit-messages.git"
  },
  "bugs": {
    "url": "https://github.com/solvelab/ai-commit-messages/issues"
  },
  "homepage": "https://github.com/solvelab/ai-commit-messages#readme",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiCommitMessages.generate",
        "title": "Generate Commit Message",
        "category": "AI Commit Messages",
        "icon": "$(sparkle)"
      },
      {
        "command": "aiCommitMessages.configure",
        "title": "Configure…",
        "category": "AI Commit Messages",
        "icon": "$(gear)"
      },
      {
        "command": "aiCommitMessages.migrateSettings",
        "title": "Import settings from the Ollama Commit extension",
        "category": "AI Commit Messages"
      },
      {
        "command": "aiCommitMessages.insertDefaultPrompt",
        "title": "Insert the default prompt into settings",
        "category": "AI Commit Messages"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aiCommitMessages.generate",
          "when": "scmProvider == git",
          "group": "navigation"
        },
        {
          "command": "aiCommitMessages.configure",
          "when": "scmProvider == git",
          "group": "navigation@99"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aiCommitMessages.generate",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "!terminalFocus"
      }
    ],
    "configuration": {
      "title": "AI Commit Messages",
      "properties": {
        "aiCommitMessages.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "openai-compat"
          ],
          "default": "ollama",
          "enumDescriptions": [
            "Ollama's native API (/api/chat).",
            "Any OpenAI-compatible endpoint (/v1/chat/completions)."
          ],
          "scope": "window",
          "markdownDescription": "Backend to generate with."
        },
        "aiCommitMessages.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "scope": "machine",
          "markdownDescription": "**Base URL** of the model server, e.g. `http://192.168.15.6:11434` — not a full endpoint.\n\nMachine-scoped on purpose: it must differ between local and remote, it is never synced, and a cloned repository must not be able to redirect your staged diff.\n\n_Because of that scope, in a remote session (WSL, SSH, container) this setting lives in the_ **Remote** _tab, not_ **User**. _Easier route:_ run **AI Commit Messages: Configure…** from the Command Palette."
        },
        "aiCommitMessages.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "scope": "window",
          "markdownDescription": "Model to generate with. Must exist on the server."
        },
        "aiCommitMessages.language": {
          "type": "string",
          "default": "pt-BR",
          "scope": "window",
          "enum": [
            "pt-BR",
            "en",
            "es",
            "fr",
            "de",
            "it"
          ],
          "enumItemLabels": [
            "Português (Brasil)",
            "English",
            "Español",
            "Français",
            "Deutsch",
            "Italiano"
          ],
          "enumDescriptions": [
            "Mensagens em português brasileiro.",
            "Messages in English.",
            "Mensajes en español.",
            "Messages en français.",
            "Nachrichten auf Deutsch.",
            "Messaggi in italiano."
          ],
          "markdownDescription": "Language of the generated commit message."
        },
        "aiCommitMessages.promptTemplate": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "scope": "window",
          "markdownDescription": "Rules sent to the model. **Leave empty to use the built-in prompt for the language chosen above** (available in Portuguese and English).\n\nTo read or adapt it, run **AI Commit Messages: Insert the default prompt into settings** — it writes the resolved text here.\n\nSubstituted when present: `{language}`, `{languageTag}`, `{types}`, `{maxBodyWords}`."
        },
        "aiCommitMessages.maxDiffChars": {
          "type": "number",
          "default": 4000,
          "minimum": 200,
          "maximum": 500000,
          "scope": "window",
          "markdownDescription": "Diff characters to send when the model's context window is unknown. When it is known, the budget is computed from it instead."
        },
        "aiCommitMessages.maxBodyWords": {
          "type": "number",
          "default": 10,
          "minimum": 3,
          "maximum": 40,
          "scope": "window",
          "markdownDescription": "Maximum words per body line."
        },
        "aiCommitMessages.temperature": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1,
          "scope": "window",
          "markdownDescription": "Sampling temperature. `0` is the right default for structured output."
        },
        "aiCommitMessages.timeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 600000,
          "scope": "window",
          "markdownDescription": "Request deadline in milliseconds. Loading a cold model can take more than 30s."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "check-types": "tsc --noEmit",
    "lint": "eslint",
    "pretest": "npm run compile-tests && node esbuild.js",
    "test": "vscode-test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "vsix": "npx --yes @vscode/vsce package --out ai-commit-messages.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.13.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^4.1.10"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The staged diff is sent to the configured model endpoint.",
      "restrictedConfigurations": [
        "aiCommitMessages.endpoint",
        "aiCommitMessages.model",
        "aiCommitMessages.promptTemplate",
        "aiCommitMessages.provider"
      ]
    }
  }
}
